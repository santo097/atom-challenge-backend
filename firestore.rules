rules_version = '2';

// Reglas restrictivas por defecto.
// Toda la lógica de acceso pasa por el backend (Cloud Functions),
// que usa el Admin SDK y bypassea estas reglas.
// Los clientes NO acceden a Firestore directamente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
